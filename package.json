{
  "name": "memorybook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3030 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:vitest": "vitest run src",
    "test:unit": "jest --config config/jest.config.cjs --runInBand",
    "test:e2e": "node scripts/run-playwright.mjs",
    "holidays:sync": "node scripts/sync-korean-holidays.mjs",
    "db:backup": "node scripts/supabase-db.mjs backup",
    "db:migrate": "node scripts/supabase-db.mjs migrate",
    "db:verify": "node scripts/supabase-db.mjs verify",
    "deploy:check": "npm run lint && npm run test:vitest && npm run test:unit && npm run test:e2e && npm run build && node scripts/check-deployment.mjs",
    "deploy:vercel": "npm run deploy:check && npx vercel --prod"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jest": "^30.0.0",
    "pg": "^8.22.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
